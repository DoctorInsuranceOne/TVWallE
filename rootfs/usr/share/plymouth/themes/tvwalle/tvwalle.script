# TVWallE boot splash: the Doctor Insurance One logo, centred on black, 40%
# of the screen's width. Installed by TVWallE provision/install.sh.
#
# sway's background (splash-3840x2160.png) and the Firefox start page draw the
# logo at the same size in the same place, so the hand-offs from Plymouth to
# sway to Firefox don't move it. Change 0.40 in all three together.
#
# Static on purpose: an animation here would jump when sway's still image
# takes over. Nothing else is drawn: no messages, no password prompt (the
# kiosk has no encrypted disk).

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.original = Image("logo.png");
logo.width = Math.Int(Window.GetWidth() * 0.40);
logo.height = Math.Int(logo.original.GetHeight() * logo.width / logo.original.GetWidth());
logo.image = logo.original.Scale(logo.width, logo.height);

logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Math.Int((Window.GetWidth() - logo.width) / 2));
logo.sprite.SetY(Window.GetY() + Math.Int((Window.GetHeight() - logo.height) / 2));
