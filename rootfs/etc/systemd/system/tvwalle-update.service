# TVWallE: install a newer signed release from GitHub, if there is one.
# Started by the web controller's "Update now" (a polkit rule lets it start
# this unit and nothing more). The nightly restart runs the same updater
# itself, just before it restarts the PC. Installed by TVWallE
# provision/install.sh.
[Unit]
Description=TVWallE update (signed releases from GitHub)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/tvwalle/tvwalle-update --apply --trigger controller
# The setup it runs can install packages; give it time.
TimeoutStartSec=60min
